# =============================================================================
#  Talend Data Services Platform - docker compose variables
#  Edit this file, then:  docker compose up -d --build
# =============================================================================

COMPOSE_PROJECT_NAME=talend-dsp

# -----------------------------------------------------------------------------
# Binaries on the (Windows) docker host
#   Folder on the docker HOST that contains the Talend zip files.
#   It is bind-mounted read-only into every container at /opt/binary.
#   Use forward slashes on Windows:  C:/Talend/binaries
#   (When DOCKER_HOST points to a remote engine, the path is resolved on THAT
#    remote Windows host, not on the machine running the docker CLI.)
# -----------------------------------------------------------------------------
BINARY_HOST_PATH=C:/Talend/binaries
BINARY_CONTAINER_PATH=/opt/binary

BINARY_TAC=Talend-AdministrationCenter-20260708_1430-V8.0.1.zip
BINARY_JOBSERVER=Talend-JobServer-20260708_1430-V8.0.1.zip
BINARY_RUNTIME=Talend-Runtime-V8.0.2.R2026-06-RT.zip

# -----------------------------------------------------------------------------
# Image / OS
# -----------------------------------------------------------------------------
DEBIAN_IMAGE=debian:trixie
JAVA_VERSION=17
TZ=Europe/Paris
LOCALE=en_US.UTF-8

# Service accounts created in the images (owner of the application folders)
TALEND_USER=talend
TALEND_UID=1001
NEXUS_USER=nexus
NEXUS_UID=1002
POSTGRES_UID=1100

# -----------------------------------------------------------------------------
# Network (bridge between containers and the docker host)
# -----------------------------------------------------------------------------
NETWORK_NAME=talend_net
NETWORK_SUBNET=172.28.10.0/24
NETWORK_GATEWAY=172.28.10.1

IP_DB=172.28.10.10
IP_NEXUS=172.28.10.11
IP_RABBITMQ=172.28.10.12
IP_TAC=172.28.10.20
IP_JOBSERVER=172.28.10.21
IP_RUNTIME=172.28.10.22

# Interface of the docker host on which ports are published
#   0.0.0.0  = reachable from the LAN, 127.0.0.1 = docker host only
HOST_BIND_IP=0.0.0.0

# -----------------------------------------------------------------------------
# Published ports  (HOST port -> container default port)
# -----------------------------------------------------------------------------
# vm_tac  (Tomcat)
HOST_PORT_TAC_HTTP=8080
HOST_PORT_TAC_HTTPS=8443

# vm_jobserver
HOST_PORT_JS_COMMAND=8000
HOST_PORT_JS_FILE=8001
HOST_PORT_JS_MONITOR=8888
HOST_PORT_JS_PROCESS=8555

# vm_runtime  (Karaf / Talend ESB Runtime)
HOST_PORT_RT_HTTP=8040
HOST_PORT_RT_HTTPS=9001
HOST_PORT_RT_SSH=8101
HOST_PORT_RT_RMI_REGISTRY=1099
HOST_PORT_RT_RMI_SERVER=44444
HOST_PORT_RT_JMS=61616
# Job Server embedded in the Runtime (shifted to avoid clash with vm_jobserver)
HOST_PORT_RT_JS_COMMAND=8100
HOST_PORT_RT_JS_FILE=8102
HOST_PORT_RT_JS_MONITOR=8889

# vm_nexus
HOST_PORT_NEXUS_HTTP=8081

# vm_rabbitmq
HOST_PORT_RABBITMQ_AMQP=5672
HOST_PORT_RABBITMQ_AMQPS=5671
HOST_PORT_RABBITMQ_MGMT=15672

# vm_db
HOST_PORT_DB=5432

# -----------------------------------------------------------------------------
# vm_db - PostgreSQL 18 settings used by scripts/vm_db/install_db.sh
#   No password here: the script asks for it (or reads DB_TAC_PASSWORD).
# -----------------------------------------------------------------------------
DB_PG_VERSION=18
DB_TAC_NAME=talend_tac
DB_TAC_USER=talend_tac
DB_SHARED_BUFFERS=512MB
DB_MAX_CONNECTIONS=200
